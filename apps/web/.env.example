# === Supabase ===
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# 서버 전용. 절대 클라이언트 번들에 넣지 말 것 (§13)
SUPABASE_SERVICE_KEY=

# === Kakao Local (Phase 2) ===
KAKAO_REST_KEY=

# === 메일 (§8) ===
# 비워두면 메일 발송이 비활성화된다 (접수는 DB 에 저장되고 email_error 에 사유가 남는다).
#
# 운영(Vercel): NHN Cloud Email — AppKey 인증이라 IP 제한이 없다
#   SMTP_HOST=smtp-mail.nhncloudservice.com / SMTP_PORT=465
#   SMTP_USER=Email 서비스 Appkey / SMTP_PASS=SecretKey
#   다우오피스는 IP 허용목록 방식이라 Vercel 발신 IP 가 거부된다 (DEPLOY.md §4-1)
# 로컬: 다우오피스 SMTP (gw.theu.co.kr:465) 를 그대로 써도 된다
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# 고객센터 수신 주소. 쉼표로 여러 개 지정 가능
COMPLAINT_MAIL_TO=
# 약물감시(PV) 담당 수신 주소. 이상사례 의심 건에만 함께 발송된다
PV_MAIL_TO=

# === 레이트리밋 (§7) ===
# 비워두면 레이트리밋이 비활성화된다. 운영 배포에서는 반드시 채울 것.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === CORS (§7) ===
# 위젯을 임베드하는 홈페이지 origin. 쉼표로 구분. 와일드카드 금지.
ALLOWED_ORIGINS=https://www.theu-pharma.co.kr,http://localhost:3000

# 제품 캐시 TTL(초). §5-1 인메모리 인덱스 갱신 주기
PRODUCT_CACHE_TTL_SECONDS=300
